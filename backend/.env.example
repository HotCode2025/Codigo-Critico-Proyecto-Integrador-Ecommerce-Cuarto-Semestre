# Copiá este archivo como .env y completá los valores.
# El .env NUNCA se sube al repositorio (está en el .gitignore).

DATABASE_URL="postgresql://USUARIO:CLAVE@localhost:5432/altos_del_uco?schema=public"
PORT=4000
JWT_SECRET="un_secreto_largo_y_random"
FRONTEND_URL="http://localhost:3000"

# Módulo 2 (autenticación): emails, separados por coma, que se registran directamente como ADMIN
ADMIN_EMAILS=""

# Módulo 3 (recuperación de contraseña, Resend). Sin la key no se manda el mail:
# el link de recuperación se imprime en la consola del backend.
RESEND_API_KEY=""
# RESEND_FROM_EMAIL="Altos del Uco <onboarding@resend.dev>"

# Módulo 5 (carrito y checkout): credenciales de PRUEBA de Mercado Pago
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
# Sólo en producción, para que Mercado Pago pueda avisar los pagos (webhook):
# BACKEND_URL="https://tu-backend.onrender.com"
COSTO_ENVIO=3000
ENVIO_GRATIS_DESDE=50000
